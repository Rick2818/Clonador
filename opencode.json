{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": "deny",
    "edit": "allow",
    "bash": {
      "*": "ask",
      "npm test": "allow",
      "npm run check": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git push*": "ask",
      "git merge*": "ask",
      "git reset*": "ask",
      "npm install*": "ask",
      "npx*": "ask"
    }
  },
  "agent": {
    "plan": {
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  }
}
